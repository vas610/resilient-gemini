# Copy to .env next to your agent: `adk run` and `adk web` load it automatically.
# Never commit the real .env.

# --- Google Cloud (required) ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# "us" = US multi-region endpoint (aiplatform.us.rep.googleapis.com)
GOOGLE_CLOUD_LOCATION=us

# --- resilient-gemini (all optional; defaults shown) ---
# RESILIENT_GEMINI_PRIMARY_MODEL=gemini-3.5-flash
# RESILIENT_GEMINI_BACKUP_MODEL=gemini-3.6-flash
# RESILIENT_GEMINI_PRIMARY_THINKING=      # minimal | low | medium | high (unset = model default)
# RESILIENT_GEMINI_BACKUP_THINKING=
# RESILIENT_GEMINI_PRIMARY_LOCATION=      # unset = GOOGLE_CLOUD_LOCATION
# RESILIENT_GEMINI_BACKUP_LOCATION=       # e.g. global, so fallback also survives a location issue

# Primary: total calls and linear step (waits 60, 120, 180, 240 s)
# RESILIENT_GEMINI_MAX_ATTEMPTS=5
# RESILIENT_GEMINI_STEP_SECONDS=60
# RESILIENT_GEMINI_STEP_JITTER=0

# Backup: SDK exponential retry
# RESILIENT_GEMINI_BACKUP_ATTEMPTS=5
# RESILIENT_GEMINI_BACKUP_INITIAL_DELAY=60
# RESILIENT_GEMINI_BACKUP_EXP_BASE=2
# RESILIENT_GEMINI_BACKUP_MAX_DELAY=300
# RESILIENT_GEMINI_BACKUP_JITTER=1

# Priority PayGo: ~2x Standard PayGo cost. Only "priority" or "spillover" turn it on.
# RESILIENT_GEMINI_PRIORITY_PAYGO=off
